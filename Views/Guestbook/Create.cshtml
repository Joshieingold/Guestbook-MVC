@model A3_Guestbook.Models.GuestbookEntry

<form method="post">
    <div asp-validation-summary="All"></div>
    <div class="d-flex flex-row justify-content-between align-items-center">
        <div class="writer-details">
            <h2>Author: <input type="text" asp-for="Author"/></h2>
        </div>
        <div class="actions-wrapper">
            <button class="btn btn-primary" asp-action="Create">Save</button>
            <a class="btn btn-danger" asp-action="List">Cancel</a>
        </div>
    </div>
    <div>
        <h4>Message:</h4>
        <textarea class="form-control" asp-for="Message"></textarea>
    </div>
</form>
