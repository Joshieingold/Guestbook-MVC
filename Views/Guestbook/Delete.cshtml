@model A3_Guestbook.Models.GuestbookEntry

<div class="card p-3 d-flex">
    <p class="text-danger">Are you sure you want to delete this entry?</p>
    <div class="button-wrapper d-flex gap-3 align-items-center">
        <form method="post"><button action="submit" class="btn btn-primary">No</button></form>
        <form method="post"><button action="submit" class="btn btn-danger">Yes</button></form>
    </div>
</div>
<div class="d-flex flex-row justify-content-between align-items-center mt-3">
    <div class="writer-details">
        <h2>Author: @Model.Author</h2>
        <p>Written At: @Model.CreatedAt</p>
    </div>
</div>
<div>
    <h4>Message:</h4>
    <p class="card p-3">@Model.Message</p>
</div>

