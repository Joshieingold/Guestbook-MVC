@model A3_Guestbook.Models.GuestbookEntry

<div class="d-flex flex-row justify-content-between align-items-center">
    <div class="writer-details">
        <h2>Author: @Model.Author</h2>
        <p>Written At: @Model.CreatedAt</p>
    </div>
    <div class="actions-wrapper d-flex gap-2">
        <form>
            <input type="hidden" name="id" value="@Model.Id"/>
            <button class="btn btn-primary" asp-action="Edit">Edit</button>
        </form>
        <form>
            <input type="hidden" name="id" value="@Model.Id"/>
            <button class="btn btn-danger" asp-action="Delete">Delete</button>
        </form>
    </div>
</div>
<div>
    <h4>Message:</h4>
    <p class="card p-3">@Model.Message</p>
</div>
