@model A3_Guestbook.Models.GuestbookEntry

<div class="d-flex flex-row justify-content-between align-items-center">
    <div class="writer-details">
        <h2>Author: <input type="text" name="Author" value="@Model.Author"/></h2>
    </div>
    <div class="actions-wrapper d-flex gap-2">
        <form method="post">
            <button class="btn btn-primary">Save</button>
        </form>
        <form method="post">
            <button class="btn btn-danger" asp-action="List">Cancel</button>
        </form>
    </div>
</div>
<div>
    <h4>Message:</h4>
    <textarea class="form-control">@Model.Message</textarea> 
</div>
