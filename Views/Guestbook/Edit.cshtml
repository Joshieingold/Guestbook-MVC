@model A3_Guestbook.Models.GuestbookEntry

<div asp-validation-summary="All"></div>
<form method="post">
    <input type="hidden" asp-for="Id" />
    <div class="d-flex flex-row justify-content-between align-items-center">
        <div class="writer-details">
            <h2>Author: <input type="text" value="@Model.Author" asp-for="Author"/></h2>
        </div>
        <div class="actions-wrapper d-flex gap-2">
            <button class="btn btn-primary" asp-action="Edit">Save</button>
            <a class="btn btn-danger" asp-action="List">Cancel</a>
        </div>
    </div>
    <div>
        <h4>Message:</h4>
        <textarea class="form-control" asp-for="Message">@Model.Message</textarea>
    </div>
</form>
