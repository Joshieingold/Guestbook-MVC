@model List<A3_Guestbook.Models.GuestbookEntry>

<div class="d-flex flex-row justify-content-between align-items-center">
    <h2>Guestbook Entries</h2>
    <form method="post">
        <button action="submit" asp-action="Create" class="btn btn-primary">New Entry</button>
    </form>
</div>

<table class="table">
    <tr>
        <th>Author</th>
        <th>Message</th>
        <th>Date</th>
        <th>Actions</th>
    </tr>
    @foreach (GuestbookEntry item in @Model)
    {
        <tr>
            <td>@item.Author</td>
            <td>@item.Message</td>
            <td>@item.CreatedAt</td>
            <td class="d-flex gap-1">
                <form method="post">
                    <input type="hidden" value="@item.Id" name="id" />
                    <button asp-action="Details" class="btn btn-info">View</button>
                    <a asp-action="Edit" class="btn btn-primary" asp-route-id="@item.Id">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                </form>
            </td>
        </tr>
    }
</table>


